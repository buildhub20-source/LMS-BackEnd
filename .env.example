# Copy to .env and fill in real values. Never commit .env.

# ---- Runtime ---------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOG_LEVEL_APP=DEBUG

# ---- Database (managed cloud Postgres / Supabase) --------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> JDBC.
#
# Use the SESSION pooler on port 5432, NOT the transaction pooler on 6543:
# Flyway takes a session-scoped advisory lock that transaction pooling breaks.
# sslmode=require is mandatory - the app refuses to start without it on a
# remote host.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
# Dedicated schema, never `public`: Supabase publishes public via its REST API.
DB_SCHEMA=lms
# The connection cap is shared by everyone pointed at the project.
DB_POOL_SIZE=5

# ---- Frontend boundary -----------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Used to build the invitation and password-reset links that go out by email.
FRONTEND_BASE_URL=http://localhost:5173

# ---- JWT -------------------------------------------------------------------
# Required in every environment, including dev - there is no built-in default.
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=lms-backend
# Access tokens are not revocable, so keep the TTL short. Revocation happens
# against the refresh session in user_session.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Authentication policy -------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILED_WINDOW=15m
INVITATION_TTL=7d
PASSWORD_RESET_TTL=30m
MAX_SESSIONS_PER_USER=10

# ---- Mail ------------------------------------------------------------------
# While false, invitation and reset messages are written to the application log
# instead of being sent. Turn this on in any environment with real users, or
# invitations cannot be delivered.
MAIL_ENABLED=false
MAIL_FROM=no-reply@lms.local
MAIL_FROM_NAME=LMS
# Only read when MAIL_ENABLED=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- First administrator (bootstrap only) ----------------------------------
# Enable once on a fresh environment, sign in, then set back to false.
# Every other account is created through the invitation flow.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# ---- Cloudflare R2 Storage -------------------------------------------------
# Obtain these from the Cloudflare dashboard -> R2 -> Manage R2 API Tokens.
# The token needs Object Read & Write scoped to the target bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=buildhub-lms
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Optional: CDN / public URL prefix for publicly readable objects.
R2_PUBLIC_URL=
