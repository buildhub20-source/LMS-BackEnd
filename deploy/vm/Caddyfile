# Routes public traffic to the containers. Cloudflare sits in front and
# terminates the visitor's HTTPS; the Cloudflare Origin certificate in ./certs
# encrypts Cloudflare -> this VM (SSL mode "Full (strict)").
#
#   <institute>.{$BASE_DOMAIN}, platform.{$BASE_DOMAIN} (platform console)
#       /api/*  -> backend   (same origin: the backend reads the institute
#                             from the Host header, as in local development)
#       other   -> frontend  (built pages)
#   chat.{$BASE_DOMAIN}    -> chat service      (institute comes from the token)
#   notify.{$BASE_DOMAIN}  -> notification service
#
# The certificate service is internal: the backend proxies to it.
# {$BASE_DOMAIN} itself and www. are the landing page, hosted elsewhere
# (Netlify); their DNS records point there, not at this VM.

{
	# Public certificates come from Cloudflare; no ACME on this host.
	auto_https off
	admin off
	servers {
		# Real visitor IPs for the backend's rate limits: trust Cloudflare's
		# ranges (generated by setup-vm.sh) and read CF-Connecting-IP.
		import /etc/caddy/cloudflare-ips.caddy
		client_ip_headers CF-Connecting-IP
	}
}

(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

https://chat.{$BASE_DOMAIN} {
	import origin_tls
	reverse_proxy chat:3001
}

https://notify.{$BASE_DOMAIN} {
	import origin_tls
	reverse_proxy notifications:3002
}

https://*.{$BASE_DOMAIN} {
	import origin_tls
	encode gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:8080
	}
}

# Cloudflare always connects over 443; anything on 80 is sent there.
http:// {
	redir https://{host}{uri} permanent
}
