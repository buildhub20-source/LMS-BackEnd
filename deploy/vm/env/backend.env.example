# Backend settings for the VM. Copy to backend.env on the VM and fill in.
# Never commit backend.env. Full descriptions: LMS-BackEnd/.env.example.
# Values marked SAME must be identical in the other services' files.

LOG_LEVEL_APP=INFO

# ---- Database (Supabase, session pooler on 5432) ---------------------------
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SCHEMA=lms
DB_POOL_SIZE=5

# ---- Addresses --------------------------------------------------------------
# Pages and API share each institute's own address, so CORS only needs the
# root domain (platform console).
CORS_ALLOWED_ORIGINS=https://gradusmind.com
FRONTEND_BASE_URL=https://gradusmind.com
TENANT_BASE_DOMAIN=gradusmind.com
TENANT_HEADER=X-Tenant-Slug
TENANT_RESOLUTION_REQUIRED=false

# ---- Secrets -----------------------------------------------------------------
# No comments after values in this file: Docker would read them as part of
# the value. Generate each secret on the VM with: openssl rand -base64 48
# SAME in chat, notifications and certificate:
JWT_SECRET=
JWT_ISSUER=lms-backend
# SAME in notifications and certificate:
SERVICE_KEY_SECRET=
# SAME in certificate (openssl rand -base64 32):
TENANT_CREDENTIAL_ENCRYPTION_KEY=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Mail -------------------------------------------------------------------
MAIL_ENABLED=true
MAIL_FROM=no-reply@gradusmind.com
MAIL_FROM_NAME=GradusMind
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- First administrators: enable once, sign in, then set back to false -----
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PLATFORM_ADMIN_ENABLED=false
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ---- Institutes (Supabase project per institute) ----------------------------
PLATFORM_ENABLED=true
TENANT_PROVISIONING_PROVIDER=SUPABASE
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORGANIZATION_SLUG=
# Mumbai, close to the VM in Central India.
SUPABASE_TENANT_REGION=ap-south-1
SUPABASE_TENANT_INSTANCE_SIZE=

# ---- Other services (URLs are set in docker-compose.yml) --------------------
CERT_SERVICE_ENABLED=true
NOTIFICATION_SERVICE_ENABLED=true

# ---- Files (Cloudflare R2) ---------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# ---- Optional -----------------------------------------------------------------
# Code runner (Judge0). Blank = "Run" for Java/Python/C/C++ is off.
CODE_RUNNER_URL=
CODE_RUNNER_API_KEY=
# Google Meet. Redirect URI is served on the root domain:
# https://gradusmind.com/api/v1/live-sessions/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# One copy only during testing.
REDIS_ENABLED=false
AI_SERVICE_ENABLED=false
