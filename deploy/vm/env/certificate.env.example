# Certificate service settings for the VM. Copy to certificate.env on the VM.
# Never commit certificate.env. Full descriptions: lms-certificate-service/.env.example.
# No comments after values: Docker would read them as part of the value.

LOG_LEVEL_APP=INFO

# Control-plane database (same Supabase project as the backend).
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SCHEMA=cert
DB_POOL_SIZE=3

# SAME values as backend.env:
JWT_SECRET=
JWT_ISSUER=lms-backend
SERVICE_KEY_SECRET=
TENANT_CREDENTIAL_ENCRYPTION_KEY=

TENANCY_ENABLED=true
TENANT_RESOLUTION_REQUIRED=false
TENANT_HEADER=X-Tenant-Slug

# Files (Cloudflare R2; the same bucket as the backend).
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Mail (certificate-issued emails).
MAIL_ENABLED=true
MAIL_FROM=no-reply@gradusmind.com
MAIL_FROM_NAME=GradusMind Certificates
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Public addresses printed on certificates and in the QR code.
PUBLIC_BASE_URL=https://platform.gradusmind.com
CERTIFICATE_VERIFY_BASE_URL=https://platform.gradusmind.com

NOTIFICATION_SERVICE_ENABLED=true
