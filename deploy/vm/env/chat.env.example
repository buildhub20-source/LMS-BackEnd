# Chat service settings for the VM. Copy to chat.env on the VM.
# Never commit chat.env. Full descriptions: LMS-Chat-Service/.env.example.
# No comments after values: Docker would read them as part of the value.

LOG_LEVEL=info

# SAME values as backend.env:
JWT_SECRET=
JWT_ISSUER=lms-backend
SERVICE_KEY_SECRET=

# Browsers on any institute subdomain may connect.
CORS_ALLOWED_ORIGINS=https://platform.gradusmind.com
CORS_ALLOWED_BASE_DOMAIN=gradusmind.com

RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_REQUESTS_PER_MINUTE=100
MESSAGE_MAX_LENGTH=4000

# Chat attachments (Cloudflare R2).
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# One copy only during testing.
REDIS_ENABLED=false
