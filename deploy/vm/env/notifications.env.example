# Notification service settings for the VM. Copy to notifications.env on the VM.
# Never commit notifications.env. Full descriptions: LMS-Notification-Service/.env.example.
# No comments after values: Docker would read them as part of the value.

LOG_LEVEL=info

# SAME values as backend.env (the service refuses to start without them):
JWT_SECRET=
JWT_ISSUER=lms-backend
SERVICE_KEY_SECRET=

# Browsers on any institute subdomain may connect.
CORS_ORIGINS=https://platform.gradusmind.com
CORS_ALLOWED_BASE_DOMAIN=gradusmind.com
